# The lint-bearing skeleton of a strict Rust workspace Cargo.toml. Copy into a
# new repository and adapt the package name/edition; everything below the
# package block is the strict baseline this repo exists to hand out.
#
# Rule of the house: every non-default setting carries its reason. An entry
# without a reason gets deleted on the next review.
#
# CI (see ci.yml) makes every warn level an error via -D warnings; the doc
# lints skip that courtesy and deny outright, locally as well as CI.

[workspace.lints.rust]
unsafe_code = "forbid"                # a panic on the product is a crash; you may flip to deny if you ship unsafe
missing_docs = "deny"                 # an undocumented public item is an error to fix, not a taste
missing_debug_implementations = "warn"
unreachable_pub = "warn"
trivial_casts = "warn"
trivial_numeric_casts = "warn"
unused_qualifications = "warn"

[workspace.lints.rustdoc]
# The whole stable group in one entry: no hand-enumeration to mistype, and
# lints rustdoc gains stay owned by the group by default. The nightly-only
# missing_doc_code_examples is deliberately outside the group: unstable means
# it churns with the channel, and it demands a runnable example on every
# documented item. missing_crate_level_docs overlaps rustc's missing_docs on
# the crate-line omission; a second gate on the same omission costs nothing.
all = "deny"

[workspace.lints.clippy]
# Individual entries at priority 0 override these groups because the groups
# sit at priority -1 (cargo manifest reference: lower priority numbers are
# overridden by higher ones).
all = { level = "warn", priority = -1 }
pedantic = { level = "warn", priority = -1 }
nursery = { level = "warn", priority = -1 }   # experimental; the pin makes its emission deterministic

# --- group exceptions carry reasons; start empty and add them as they fire
# future_not_send = "allow"             # e.g. template: single-threaded UI executor

# --- restriction picks: not enabled by default; pick the ones your codebase
# has real failure modes for, one reason each
unwrap_used = "warn"                  # where a panic would be a crash, not a stack trace somebody reads
expect_used = "warn"
panic = "warn"
todo = "warn"
unimplemented = "warn"
dbg_macro = "warn"
print_stdout = "warn"
print_stderr = "warn"

# Every crate in the workspace inherits the table ([lints] workspace = true
# below); cargo will not mix an inherited table with a package-local one, so
# all levels belong here, workspace-wide.
