{
	// The lockfile policy: every package resolves from the official npm
	// registry over HTTPS, every entry names its own package, and every
	// integrity hash is sha512. No host or scheme is allowed without a
	// reason; adding one is a policy change, not a fix.
	"allowedHosts": ["registry.npmjs.org"],
	"allowedSchemes": ["https:"],
	"validateHttps": true,
	"validatePackageNames": true,
	"validateIntegrity": true,
	"emptyHostname": false,
	"path": "package-lock.json",
	"type": "npm"
}