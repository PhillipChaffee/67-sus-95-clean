{
  "name": "rename-this-package",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "format:check": "prettier --check .",
    "knip": "knip",
    "lint": "eslint .",
    "lint:graph": "depcruise --validate .dependency-cruiser.cjs src",
    "lint:lockfile": "lockfile-lint -p package-lock.json -t npm -a registry.npmjs.org -o \"https:\" -n -i -e false",
    "test": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@vitest/coverage-v8": "5.0.0",
    "@vitest/eslint-plugin": "1.6.27",
    "dependency-cruiser": "18.3.1",
    "eslint": "10.10.0",
    "eslint-plugin-jsdoc": "64.3.8",
    "eslint-plugin-sonarjs": "4.2.1",
    "knip": "6.35.1",
    "lockfile-lint": "5.0.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.0"
  }
}
